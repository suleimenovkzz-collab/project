PORT=3000
# В production не короче 12 символов, иначе сервер не стартует
ADMIN_PASSWORD=смените_на_надёжный_пароль

# На боевом сервере обязательно:
# NODE_ENV=production

# Сайт за nginx / Caddy / Cloudflare: 1 (за Cloudflare + nginx — 2).
# Без прокси не задавайте — иначе лимиты обходятся подменой X-Forwarded-For.
# TRUST_PROXY=1

# Курсы валют обновляются автоматически раз в час: официальный курс Нацбанка РК,
# при его недоступности — open.er-api.com. Последний удачный курс сохраняется в data/fx-rates.json.
# Задайте курс вручную, только если нужен фиксированный (сколько тенге за 1 единицу) — он важнее автокурса:
# FX_USD_KZT=450
# FX_EUR_KZT=505
# FX_RUB_KZT=5.4
# Отключить автообновление (тогда — сохранённый курс или аварийные 480/520/5.2):
# FX_AUTO_UPDATE=0

# Максимум штук одной позиции в заказе (по умолчанию 10)
# ORDER_MAX_QTY_PER_ITEM=10

# Вставьте ключ OpenAI сюда (начинается с sk-):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Контакты на сайте, в ELLA и в счетах. Значения по умолчанию — в config/contacts.defaults.json.
# Достаточно поменять здесь и перезапустить сервер — пересобирать фронтенд не нужно.
# Некорректный номер WhatsApp не даст серверу стартовать (чтобы смена не прошла «наполовину»).
# CONTACT_WHATSAPP=77787422472
# CONTACT_PHONE=+7 778 742 24 72
# CONTACT_TELEGRAM=alisher_suleimenov
# CONTACT_INSTAGRAM=alisher_suleimenov
# CONTACT_EMAIL=
# CONTACT_CITY=Астана
# CONTACT_ADDRESS=Астана, ул. Алихан Бокейхан, 16/2
# CONTACT_ADDRESS_NOTE=район Есиль
# CONTACT_MAP_URL=https://2gis.kz/astana/geo/70000001089339921

# На HTTPS-проде cookie admin_token станет Secure автоматически при NODE_ENV=production.
# Или принудительно: COOKIE_SECURE=1
# COOKIE_SECURE=1

# Путь к SQLite (по умолчанию data/app.db)
# SQLITE_PATH=data/app.db

# Реквизиты продавца для PDF-счетов (опционально)
# COMPANY_LEGAL_NAME=ИП Алишер Галымханович Сулейменов
# COMPANY_IIN_BIN=000000000000
# COMPANY_BANK_NAME=АО «Kaspi Bank»
# COMPANY_IBAN=KZ000000000000000000
# COMPANY_BIK=CASPKZKA
# COMPANY_PHONE= (по умолчанию CONTACT_PHONE)
# COMPANY_EMAIL=
# COMPANY_ADDRESS=г. Астана
# COMPANY_TAX_NOTE=Без НДС
